# Copier ce fichier en .env et l'adapter. Ne jamais versionner .env.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=votrecompte.pythonanywhere.com
# URL secrète de l'admin (terminer par /)
ADMIN_URL=gestion-xyz/

# Base de données : sqlite (par défaut) ou mysql
DB_ENGINE=sqlite
# DB_NAME=votrecompte$portfolio
# DB_USER=votrecompte
# DB_PASSWORD=
# DB_HOST=votrecompte.mysql.pythonanywhere-services.com

# Informations du site
PORTFOLIO_NOM=Votre Nom
PORTFOLIO_TITRE=Technicien IT Support | Systèmes & Réseaux
PORTFOLIO_VILLE=Bénin
PORTFOLIO_EMAIL=
PORTFOLIO_TELEPHONE=
PORTFOLIO_GITHUB=
PORTFOLIO_LINKEDIN=
PORTFOLIO_BLOG=True

# Notification e-mail des messages de contact (optionnel, Gmail + mot de passe d'application)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=vous@gmail.com
# EMAIL_HOST_PASSWORD=
# CONTACT_NOTIFY_EMAIL=vous@gmail.com
